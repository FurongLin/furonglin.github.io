# Only set actual values in local .env or Vercel environment variables.
GOOGLE_CLIENT_ID=
ALLOWED_GOOGLE_EMAIL=
# Optional additional restriction: the stable Google account subject ID.
ALLOWED_GOOGLE_SUB=
# Set only after confirming the key belongs to a Gemini Free Tier project with billing disabled.
GEMINI_FREE_TIER_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ALLOWED_ORIGINS=https://furonglin.github.io,http://localhost:8000,http://127.0.0.1:8000
NODEJS_HELPERS=0
